{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2muni-labs/orchestrator/schemas/cli/events.v1.json",
  "title": "orch events line",
  "description": "One line of orch events (JSON Lines). An error is printed as one error object instead. Version 1. Fields may be added within this version and readers must ignore fields they do not know; removing, renaming or changing a field's meaning or format needs version 2 (technical design 4.13).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "task_id",
        "target",
        "from_state",
        "to_state",
        "actor",
        "note",
        "at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "from_state": {
          "enum": [
            "prepared",
            "queued",
            "reserved",
            "running",
            "judging",
            "gating",
            "reviewing",
            "ready",
            "conflict",
            "pr_open",
            "closed",
            "blocked",
            "discarded",
            "orphaned"
          ]
        },
        "to_state": {
          "enum": [
            "prepared",
            "queued",
            "reserved",
            "running",
            "judging",
            "gating",
            "reviewing",
            "ready",
            "conflict",
            "pr_open",
            "closed",
            "blocked",
            "discarded",
            "orphaned"
          ]
        },
        "actor": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ok",
        "schema_version",
        "error",
        "message"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    }
  ]
}
